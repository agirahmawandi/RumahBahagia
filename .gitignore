# ============================================================================
# .gitignore — RumahBahagia (Next.js 15 + Supabase + Tailwind v4)
# ============================================================================

# 1. Kredensial, Lingkungan & Rahasia (CRITICAL SECURITY)
.env*
!.env.example
*.key
*.secret
*.pem
*.crt
*.cert
*.p12
*.pfx
service-account*.json
credentials*.json
.mcp.json
mcp_config.json

# 2. Dependencies & Paket Manajer
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 3. Build & Output Kompilasi
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# 4. Platform Hosting & Cloud CLI Cache
.vercel
.turbo
.supabase/

# 5. Testing, Liputan & Laporan QA
/coverage
test-results/
playwright-report/
blob-report/

# 6. Log & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 7. File Sistem Operasi & Editor Lokal
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
